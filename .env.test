# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
MAILER_DSN=null://null

# Scoped HTTP clients reject an empty base_uri, and Doctrine builds
# RevokeOidcGrantsListener (hence the Hydra client) on the first query. Tests
# mock both upstreams; these only need to be valid URLs.
HYDRA_ADMIN_URL=http://hydra.invalid:4445
LLDAP_URL=http://lldap.invalid:17170
