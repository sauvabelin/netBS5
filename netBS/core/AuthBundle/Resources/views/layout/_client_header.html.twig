{#
    Auth card header: the OIDC client's branding when `oidc_client` (Hydra
    client metadata) has a name, the netBS logo otherwise.

    Variables:
      - oidc_client — Hydra client array (`client_name`, optional `logo_uri`) or null
      - heading     — shown before the client name ("<heading> <client_name>")
      - fallback    — heading when there is no client
#}
{% if oidc_client and oidc_client.client_name %}
    {% if oidc_client.logo_uri %}
        <img src="{{ oidc_client.logo_uri }}" alt="{{ oidc_client.client_name }}" height="64" class="logo-img">
    {% else %}
        <img src="{{ asset('bundles/netbscore/img/logo.png') }}" alt="logo" width="64" height="64" class="logo-img">
    {% endif %}
    <h5 class="card-title">{{ heading }} <strong>{{ oidc_client.client_name }}</strong></h5>
    <p class="text-muted small mb-0">via {{ param('app', 'name') }}</p>
{% else %}
    <img src="{{ asset('bundles/netbscore/img/logo.png') }}" alt="logo" width="64" height="64" class="logo-img">
    <h5 class="card-title">{{ fallback }}</h5>
{% endif %}
