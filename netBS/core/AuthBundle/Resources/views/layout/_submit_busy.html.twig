{# Spinner shown by the submit-busy Stimulus controller once the form is submitted. #}
<div data-submit-busy-target="busy" class="d-none text-center py-5" role="status">
    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" aria-hidden="true"></div>
    <p class="fs-5 mb-0">{{ label }}</p>
</div>
