{% extends '@NetBSCore/layout/backend.layout.twig' %}

{% set title %}Groupes{% endset %}

{% macro problem_badge(problem) %}
    {% if problem is not null %}
        <span class="badge bg-danger" title="{{ problem }}">en erreur</span>
        <div class="small text-danger">{{ problem }}</div>
    {% endif %}
{% endmacro %}

{% block main %}
    <div class="container-fluid">
        {% include '@NetBSCore/includes/header.include.twig' with {
            header: 'Authentification',
            subHeader: 'Groupes'
        } %}

        <div class="row">
            <div class="col-12">
                <div class="card" id="ldap-publication-rules">
                    <div class="card-header d-flex align-items-center">
                        <h5 class="card-title mb-0 me-auto">Groupes partagés</h5>
                        <button class="btn btn-primary btn-sm" data-controller="modal" data-modal-url-value="{{ path('auth.admin.ldap.rule.add') }}" data-action="click->modal#open">
                            <i class="fas fa-plus"></i> Ajouter une règle
                        </button>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">Choisissez quels groupes netBS sont partagés avec les autres outils (Nextcloud, wiki…). Les règles sont lues dans l'ordre : un groupe suit la première règle qui le concerne. Un groupe qu'aucune règle ne concerne n'est pas partagé.</p>
                        {% if rules is empty %}
                            <p class="mb-0">Aucune règle : aucun groupe n'est partagé.</p>
                        {% else %}
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr><th>Règle</th><th>Groupes concernés</th><th>Qui est membre</th><th class="text-end">Actions</th></tr>
                                </thead>
                                <tbody>
                                    {% for view in rules %}
                                        {% set rule = view.rule %}
                                        <tr data-rule-id="{{ rule.id }}">
                                            <td>{{ rule.label }} {{ _self.problem_badge(view.problem) }}</td>
                                            <td>{{ view.selection }}</td>
                                            <td>{{ view.membres }}</td>
                                            <td class="text-end text-nowrap">
                                                <button class="btn btn-outline-secondary btn-sm" title="Modifier" data-controller="modal" data-modal-url-value="{{ path('auth.admin.ldap.rule.edit', {id: rule.id}) }}" data-action="click->modal#open"><i class="fas fa-edit"></i></button>
                                                {% for direction, icon in {up: 'fa-arrow-up', down: 'fa-arrow-down'} %}
                                                    <form method="post" action="{{ path('auth.admin.ldap.rule.move', {id: rule.id, direction: direction}) }}" class="d-inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('ldap-rule-' ~ rule.id) }}">
                                                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="{{ direction == 'up' ? 'Monter' : 'Descendre' }}"
                                                                {{ (direction == 'up' and loop.parent.loop.first) or (direction == 'down' and loop.parent.loop.last) ? 'disabled' }}><i class="fas {{ icon }}"></i></button>
                                                    </form>
                                                {% endfor %}
                                                <form method="post" action="{{ path('auth.admin.ldap.rule.delete', {id: rule.id}) }}" class="d-inline" data-turbo-confirm="Supprimer la règle « {{ rule.label }} » ?">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('ldap-rule-' ~ rule.id) }}">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer"><i class="fas fa-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="card" id="ldap-computed-groups">
                    <div class="card-header d-flex align-items-center">
                        <h5 class="card-title mb-0 me-auto">Groupes automatiques</h5>
                        <button class="btn btn-primary btn-sm" data-controller="modal" data-modal-url-value="{{ path('auth.admin.ldap.computed.add') }}" data-action="click->modal#open">
                            <i class="fas fa-plus"></i> Ajouter un groupe
                        </button>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">Des groupes sans équivalent dans netBS : leurs membres sont tous ceux qui remplissent les conditions (ex. « tous les chefs actifs »).</p>
                        {% if computedGroups is empty %}
                            <p class="mb-0">Aucun groupe automatique.</p>
                        {% else %}
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr><th>Nom</th><th>Membres</th><th>Description</th><th class="text-end">Actions</th></tr>
                                </thead>
                                <tbody>
                                    {% for view in computedGroups %}
                                        {% set group = view.group %}
                                        <tr data-computed-id="{{ group.id }}">
                                            <td>{{ group.name }} {{ _self.problem_badge(view.problem) }}</td>
                                            <td>{{ view.membres }}</td>
                                            <td>{{ group.description }}</td>
                                            <td class="text-end text-nowrap">
                                                <button class="btn btn-outline-secondary btn-sm" title="Modifier" data-controller="modal" data-modal-url-value="{{ path('auth.admin.ldap.computed.edit', {id: group.id}) }}" data-action="click->modal#open"><i class="fas fa-edit"></i></button>
                                                <form method="post" action="{{ path('auth.admin.ldap.computed.delete', {id: group.id}) }}" class="d-inline" data-turbo-confirm="Supprimer le groupe automatique « {{ group.name }} » ?">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('ldap-computed-' ~ group.id) }}">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer"><i class="fas fa-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                {% if notConfigured is not null %}
                    <div id="ldap-not-configured" class="alert alert-warning">{{ notConfigured }}</div>
                {% else %}
                    {# Member counts are fetched per row on hover: resolving every group up front is slow. #}
                    <div class="card card-table" id="ldap-groups" data-controller="lazy-count" data-action="mouseover->lazy-count#load">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Aperçu des groupes partagés</h5>
                        </div>
                        <div class="card-body">
                            {{ render_list('netbs.auth.ldap.groups', 'netbs', {rows: groupRows}) }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
