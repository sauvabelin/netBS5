{% extends '@NetBSCore/layout/modal.layout.twig' %}

{% block size %}wide{% endblock %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="row">
        <div class="col-md-6">{{ form_row(form.name) }}</div>
        <div class="col-md-6">{{ form_row(form.description) }}</div>
    </div>
    {{ form_row(form.membresJson) }}
    {{ form_end(form) }}
{% endblock %}
