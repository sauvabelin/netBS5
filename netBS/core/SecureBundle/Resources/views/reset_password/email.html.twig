{% extends '@NetBSCore/mailer/layout.html.twig' %}
{% import '@NetBSCore/mailer/_macros.html.twig' as mail %}

{% set resetUrl = url('netbs.secure.password_reset.reset_form', { token: resetToken.token }) %}

{% block preheader %}Choisissez un nouveau mot de passe pour le compte {{ user.loginUsername }}.{% endblock %}

{% block heading %}Réinitialiser votre mot de passe{% endblock %}

{% block content %}
    {{ mail.paragraph('Bonjour ' ~ user ~ ',') }}
    <p style="margin: 0 0 16px;">
        Nous avons reçu une demande de réinitialisation du mot de passe de votre compte netBS
        <strong style="color: #0f172a;">{{ user.loginUsername }}</strong>.
        Cliquez sur le bouton ci-dessous pour en choisir un nouveau.
    </p>
    {{ mail.button(resetUrl, 'Choisir un nouveau mot de passe') }}
    {{ mail.fallback_link(resetUrl) }}
    {{ mail.notice("Ce lien est valable " ~ include('@NetBSSecure/reset_password/_validity.txt.twig') ~ " et ne peut être utilisé qu'une seule fois. Si vous n'êtes pas à l'origine de cette demande, ignorez simplement cet e-mail : votre mot de passe reste inchangé.") }}
{% endblock %}
