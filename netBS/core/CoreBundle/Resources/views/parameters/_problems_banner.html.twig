{# Important settings that are missing or point to a deleted row: the features using them are off until fixed. #}
{% if is_granted('ROLE_ADMIN') %}
    {% set problems = settings_problems() %}
    {% if problems|length > 0 %}
        <div class="alert alert-danger mx-3 mt-3 mb-0" role="alert">
            <i class="fas fa-exclamation-triangle me-1"></i>
            {{ problems|length }} paramètre(s) important(s) à corriger :
            {% for problem in problems %}
                <a class="alert-link" href="{{ path('netbs.core.parameters.list') }}#setting-{{ problem.definition.namespace }}-{{ problem.definition.key|replace({'.': '-'}) }}"
                   title="{{ problem.message }}">{{ problem.definition.label }}</a>{% if not loop.last %}, {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endif %}
