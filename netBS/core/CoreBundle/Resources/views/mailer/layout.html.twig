{#
    Shared HTML layout for every email netBS sends.

    Blocks:
      - preheader    — one-line summary shown next to the subject in inbox lists
      - heading      — big title at the top of the card
      - content      — body of the card (use the macros in _macros.html.twig)
      - footer_note  — small print under the card (default: automated-mail notice)

    Table-based with inline styles on purpose: Outlook and Gmail ignore most
    <style> rules. Keep new templates to the same pattern.
#}
<!DOCTYPE html>
<html lang="fr" xmlns:v="urn:schemas-microsoft-com:vml">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>{{ block('heading') }}</title>
    <!--[if mso]>
    <style>td,th,div,p,a,h1 {font-family: "Segoe UI", Arial, sans-serif; mso-line-height-rule: exactly;}</style>
    <![endif]-->
    <style>
        @media (max-width: 620px) {
            .card { padding: 28px 20px !important; }
            .outer { padding: 24px 12px !important; }
        }
    </style>
</head>
<body style="margin: 0; padding: 0; width: 100%; background-color: #f1f5f9; -webkit-font-smoothing: antialiased; word-break: break-word;">
<div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">{% block preheader %}{% endblock %}&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f1f5f9;">
    <tr>
        <td class="outer" align="center" style="padding: 40px 16px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px;">
                <tr>
                    <td align="center" style="padding-bottom: 24px;">
                        <img src="{{ absolute_url(asset('bundles/netbscore/img/logo.png')) }}" width="56" height="59" alt="{{ param('app', 'organization') }}" style="display: block; border: 0;">
                    </td>
                </tr>
                <tr>
                    <td class="card" style="background-color: #ffffff; border-radius: 8px; border: 1px solid #e2e8f0; padding: 40px; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 24px; color: #334155;">
                        <h1 style="margin: 0 0 24px; font-size: 22px; line-height: 30px; font-weight: 700; color: #0f172a;">{% block heading %}{% endblock %}</h1>
                        {% block content %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td align="center" style="padding: 24px 16px 0; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #64748b;">
                        {% block footer_note %}Cet e-mail a été envoyé automatiquement par {{ param('app', 'name') }}, merci de ne pas y répondre.{% endblock %}
                        <br>{{ param('app', 'organization') }}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
