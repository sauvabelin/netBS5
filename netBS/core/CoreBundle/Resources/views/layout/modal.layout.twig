{% set _modal %}

    {% set title %}{% block title %}{% endblock %}{% endset %}
    {# narrow | wide — see assets/styles/bootstrap/_modals.scss #}
    {% set modal_size %}{% block size %}narrow{% endblock %}{% endset %}

    <div class="modal-dialog modal-{{ modal_size|trim }}" {% block modalAttrs %}{% endblock %}>
        <div class="modal-content">
            {% if title %}
                <div class="modal-header">
                    <h5 class="modal-title">{{ title }}</h5>
                    <button type="button" data-bs-dismiss="modal" aria-label="Close" class="btn-close"></button>
                </div>
            {% endif %}

            <div class="modal-body" {% block bodyAttr %}{% endblock %}>
                {% block content %}{% endblock %}
            </div>

            <div class="modal-footer">
                {% block footer %}
                    <button type="button" data-bs-dismiss="modal" class="btn btn-secondary">Fermer</button>
                    <button type="button" data-modal-validate id="validate-modal-btn" class="btn btn-primary">Valider</button>
                {% endblock %}
            </div>
        </div>
    </div>
{% endset %}

<!doctype HTML>

{{ dumpCss() }}

{{ _modal }}

