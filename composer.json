{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "beberlei/doctrineextensions": "^1.3",
        "doctrine/doctrine-bundle": "^2.5",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^2.11",
        "erusev/parsedown": "^1.7",
        "genkgo/camt": "^2.3",
        "google/apiclient": "^2.12.1",
        "lexik/jwt-authentication-bundle": "^2.14",
        "liip/imagine-bundle": "^2.13",
        "nelmio/cors-bundle": "^2.2",
        "predis/predis": "^2.0",
        "setasign/fpdf": "^1.8",
        "sprain/swiss-qr-bill": "^4.0",
        "stof/doctrine-extensions-bundle": "^1.7",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.7",
        "symfony/notifier": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/redis-messenger": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stimulus-bundle": "^2.35",
        "symfony/string": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-autocomplete": "^2.35",
        "symfony/ux-live-component": "^2.35",
        "symfony/ux-turbo": "^2.35",
        "symfony/validator": "7.4.*",
        "symfony/web-link": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/reset-password-bundle": "^1.21",
        "symfonycasts/sass-bundle": "^0.9.0",
        "tecnickcom/tcpdf": "^6.4",
        "twbs/bootstrap": "^5.3",
        "twig/cssinliner-extra": "^3.26",
        "twig/extra-bundle": "^3.29",
        "twig/twig": "^3.3"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "NetBS\\CoreBundle\\": "netBS/core/CoreBundle",
            "NetBS\\SecureBundle\\": "netBS/core/SecureBundle",
            "NetBS\\FichierBundle\\": "netBS/core/FichierBundle",
            "NetBS\\ListBundle\\": "netBS/core/ListBundle",
            "NetBS\\AuthBundle\\": "netBS/core/AuthBundle",
            "Ovesco\\FacturationBundle\\": "netBS/ovesco/FacturationBundle",
            "Iacopo\\MailingBundle\\": "netBS/iacopo/MailingBundle"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*"
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        },
        "google/apiclient-services": [
            "Calendar"
        ]
    },
    "require-dev": {
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.36",
        "symfony/phpunit-bridge": "^7.0",
        "symfony/stopwatch": "7.4.*",
        "symfony/var-dumper": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    }
}
