{% extends 'emails/apmbs_layout.html.twig' %}
{% import '@NetBSCore/mailer/_macros.html.twig' as mail %}
{% import 'emails/_apmbs_macros.html.twig' as apmbs %}

{% block heading %}Facture{% endblock %}
{% block preheader %}Votre facture pour le séjour à {{ reservation.cabane.nom }} est jointe à cet e-mail.{% endblock %}
{% block status_label %}Facture{% endblock %}

{% block intro %}{{ reservation.cabane.invoiceEmail }}{% endblock %}

{% block details_title %}Détails de la facture{% endblock %}

{% block details_extra %}
    {{ apmbs.row('Location ' ~ reservation.cabane.nom, reservation.finalPrice ~ ' CHF') }}
    {% if autreFrais %}{{ apmbs.row(autreFrais.message ?: 'Autres frais', autreFrais.montant ~ ' CHF') }}{% endif %}
{% endblock %}

{% block after_details %}
    {{ mail.notice('La facture (PDF avec bulletin QR) est jointe à cet e-mail.') }}
{% endblock %}
