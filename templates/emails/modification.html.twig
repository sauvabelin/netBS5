{% extends 'emails/apmbs_layout.html.twig' %}
{% import '@NetBSCore/mailer/_macros.html.twig' as mail %}
{% import 'emails/_apmbs_macros.html.twig' as apmbs %}

{% block heading %}Modification proposée{% endblock %}
{% block preheader %}Nous vous proposons de nouvelles dates pour {{ reservation.cabane.nom }}. Merci de confirmer ou de refuser.{% endblock %}
{% block status_label %}À confirmer{% endblock %}
{% block status_variant %}warning{% endblock %}

{% block intro %}
    {% if reservation.cabane.correctionEmail %}<p>{{ reservation.cabane.correctionEmail|nl2br }}</p>{% endif %}
{% endblock %}

{% block details_title %}Dates proposées{% endblock %}

{% block details %}
    {{ apmbs.change_row('Arrivée', oldStart|date(param('format', 'php_datetime')), reservation.start|date(param('format', 'php_datetime'))) }}
    {{ apmbs.change_row('Départ', oldEnd|date(param('format', 'php_datetime')), reservation.end|date(param('format', 'php_datetime'))) }}
{% endblock %}

{% block actions %}
    {% if toApmbs %}
        {{ mail.notice("Le demandeur doit accepter ou refuser ces dates depuis son propre e-mail.") }}
    {% else %}
        <p class="section-title">Ces dates vous conviennent-elles&nbsp;?</p>
        {{ mail.button(acceptUrl, 'Accepter les nouvelles dates', 'success') }}
        {{ mail.button(rejectUrl, 'Refuser et annuler la réservation', 'danger') }}
    {% endif %}
{% endblock %}
