{% extends 'emails/apmbs_layout.html.twig' %}
{% import 'emails/_apmbs_macros.html.twig' as apmbs %}

{% block heading %}Réservation confirmée{% endblock %}
{% block preheader %}Votre réservation de {{ reservation.cabane.nom }} du {{ reservation.start|date(param('format', 'php_date')) }} au {{ reservation.end|date(param('format', 'php_date')) }} est confirmée.{% endblock %}
{% block status_label %}Confirmée{% endblock %}
{% block status_variant %}success{% endblock %}

{% block intro %}
    {% if reservation.cabane.confirmedEmail %}<p>{{ reservation.cabane.confirmedEmail|nl2br }}</p>{% endif %}
{% endblock %}

{% block details %}
    {{ apmbs.dates(reservation) }}
    {{ apmbs.intendant("Intendant à l'ouverture", reservation.intendantDebut) }}
    {{ apmbs.intendant('Intendant à la fermeture', reservation.intendantFin) }}
    {% if reservation.estimatedPrice %}{{ apmbs.row('Prix estimé', reservation.estimatedPrice ~ ' CHF') }}{% endif %}
{% endblock %}

{% block after_details %}
    {% if reservation.cabane.conditionsList %}
        <p class="section-title">Conditions de la cabane</p>
        <p>Merci de prendre connaissance des conditions suivantes avant votre arrivée&nbsp;:</p>
        <ul class="conditions">
            {% for condition in reservation.cabane.conditionsList %}
                <li>{{ condition }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
