{% extends 'emails/apmbs_layout.txt.twig' %}

{% block heading %}Modification proposée{% endblock %}
{% block status_label %}À confirmer{% endblock %}
{% block intro %}{{ reservation.cabane.correctionEmail }}{% endblock %}
{% block details_title %}Dates proposées{% endblock %}

{% block details %}
Arrivée : {{ reservation.start|date(fmt) }} (auparavant {{ oldStart|date(fmt) }})
Départ : {{ reservation.end|date(fmt) }} (auparavant {{ oldEnd|date(fmt) }})
