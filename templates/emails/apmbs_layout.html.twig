{% extends '@NetBSCore/mailer/layout.html.twig' %}
{% import '@NetBSCore/mailer/_macros.html.twig' as mail %}
{% import 'emails/_apmbs_macros.html.twig' as apmbs %}
{#
    Base for the APMBS reservation emails: the shared netBS layout, branded
    "APMBS". Each email sets heading and preheader, plus:
      - status_label / status_variant — banner under the reservation number
        (variant: success, warning, danger, or empty for grey)
      - intro          — the cabane's own text for this step (Cabane::*Email)
      - details_title  — title of the reservation table
      - details        — its rows (macros in _apmbs_macros.html.twig)
      - after_details  — anything between the table and the intendant's message
      - actions        — anything after the message
    toApmbs is true on the internal copy sent to the cabane's address.
#}

{% block brand %}APMBS{% endblock %}

{% block content %}
    {% if toApmbs %}
        {{ mail.notice("Copie interne de l'e-mail envoyé à " ~ reservation.prenom ~ ' ' ~ reservation.nom ~ ' (' ~ reservation.email ~ ').') }}
        {{ mail.button(url('sauvabelin.apmbs.reservation', {id: reservation.id}), 'Gérer la réservation') }}
    {% endif %}

    <p class="meta">{{ reservation.cabane.nom }} · Réservation n°&nbsp;{{ reservation.id }}</p>
    {# Same box as mail.button, so the status reads at a glance. #}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="btn-table">
        <tr>
            <td align="center" class="status status-{{ block('status_variant') }}">{{ block('status_label') }}</td>
        </tr>
    </table>

    {% if not toApmbs %}
        <p>Bonjour {{ reservation.prenom }},</p>
    {% endif %}
    {% block intro %}{% endblock %}

    <p class="section-title">{% block details_title %}Votre réservation{% endblock %}</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="details">
        {% block details %}{{ apmbs.dates(reservation) }}{% endblock %}
    </table>

    {% block after_details %}{% endblock %}

    {% if message %}
        <p class="section-title">Message de l'intendant</p>
        <p class="message">{{ message|nl2br }}</p>
    {% endif %}

    {% block actions %}{% endblock %}

    <p class="signature">Meilleures salutations,<br>L'APMBS</p>
{% endblock %}

{% block footer_note %}
    {%- if toApmbs -%}
        Copie interne envoyée à l'adresse de la cabane.
    {%- else -%}
        Vous recevez cet e-mail suite à votre demande de réservation pour {{ reservation.cabane.nom }}. Pour toute question, répondez simplement à ce message.
    {%- endif -%}
{% endblock %}
