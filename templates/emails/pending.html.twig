{% extends 'emails/apmbs_layout.html.twig' %}
{% import 'emails/_apmbs_macros.html.twig' as apmbs %}

{% block heading %}Demande reçue{% endblock %}
{% block preheader %}Nous avons bien reçu votre demande pour {{ reservation.cabane.nom }} du {{ reservation.start|date(param('format', 'php_date')) }} au {{ reservation.end|date(param('format', 'php_date')) }}.{% endblock %}
{% block status_label %}En attente{% endblock %}
{% block status_variant %}{% endblock %}

{% block intro %}
    {% if reservation.cabane.receivedEmail %}<p>{{ reservation.cabane.receivedEmail|nl2br }}</p>{% endif %}
{% endblock %}

{% block details %}
    {{ apmbs.dates(reservation) }}
    {{ apmbs.row('Nom', reservation.prenom ~ ' ' ~ reservation.nom) }}
    {{ apmbs.row('Groupe', reservation.unite) }}
    {{ apmbs.row('Téléphone', reservation.phone) }}
    {{ apmbs.row('E-mail', reservation.email) }}
    {{ apmbs.row('Adresse', reservation.rue ~ ', ' ~ reservation.npa ~ ' ' ~ reservation.localite) }}
    {% if reservation.description %}{{ apmbs.row('Commentaire', reservation.description, true) }}{% endif %}
{% endblock %}
