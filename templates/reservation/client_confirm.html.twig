{% extends '@NetBSCore/layout/base.layout.twig' %}

{% block body %}
{% set isAccept = action == 'accept' %}
{% set color = isAccept ? '#10b981' : '#ef4444' %}
<div style="display:flex;flex-direction:column;width:100vw;min-height:100vh;justify-content:center;align-items:center;background:#eeeeee;padding:20px 0;">
    <img src="{{ asset('bundles/netbscore/img/logo.svg') }}" alt="logo" width="62" height="64" class="logo-img" />
    <p style="margin-top:30px; margin-bottom:0; text-align: center; font-size: 16px; font-weight: 700; color: #334155;">
        {{ reservation.cabane.nom }}
    </p>
    <div style="margin-top:30px;background:white;box-shadow:0 10px 20px #dddddd; border-radius:5px;padding:20px;max-width:480px;">
        <p style="margin: 0 0 20px; border-radius: 4px; background-color: {{ color }}; padding: 12px 16px; text-align: center; font-size: 20px; font-weight: 700; color: #fffffe; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05)">
            {{ isAccept ? 'Accepter la modification' : 'Refuser la modification' }}
        </p>

        <p style="margin: 0 0 8px; font-weight: 600; color: #0f172a">Dates proposées</p>
        <table style="width:100%; margin-bottom: 20px; color: #334155; background-color: #f1f5f9; border-radius: 4px;" cellpadding="8" cellspacing="0">
            <tr>
                <td style="font-weight: 700; width: 80px;">Début</td>
                <td>{{ reservation.start|date(datetime_format) }}</td>
            </tr>
            <tr>
                <td style="font-weight: 700;">Fin</td>
                <td>{{ reservation.end|date(datetime_format) }}</td>
            </tr>
        </table>

        <p class="text-center" style="color: #334155;">
            {% if isAccept %}
                En confirmant, vous acceptez les nouvelles dates proposées par l'APMBS.
            {% else %}
                En confirmant, vous refusez les nouvelles dates et votre demande de réservation sera annulée.
            {% endif %}
        </p>

        <form method="post">
            <button type="submit" style="display: block; width: 100%; border: 0; border-radius: 4px; background-color: {{ color }}; padding: 10px 16px; text-align: center; font-weight: 700; color: #fffffe; cursor: pointer;">
                {{ isAccept ? 'Confirmer et accepter' : 'Confirmer et annuler la réservation' }}
            </button>
        </form>

        <p class="text-center mb-0" style="margin-top: 16px; font-size: 14px;">
            {% if isAccept %}
                <a href="{{ path('apmbs.api.client.reject', {'id': reservation.id, 'token': token}) }}">Je souhaite plutôt refuser la modification</a>
            {% else %}
                <a href="{{ path('apmbs.api.client.accept', {'id': reservation.id, 'token': token}) }}">Je souhaite plutôt accepter la modification</a>
            {% endif %}
        </p>
    </div>
</div>
{% endblock %}
