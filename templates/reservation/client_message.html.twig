{% extends '@NetBSCore/layout/base.layout.twig' %}

{% block body %}
<div style="display:flex;flex-direction:column;width:100vw;height:100vh;justify-content:center;align-items:center;background:#eeeeee">
    <img src="{{ asset('bundles/netbscore/img/logo.svg') }}" alt="logo" width="62" height="64" class="logo-img" />
    {% if reservation %}
    <p style="margin-top:30px; margin-bottom:0; text-align: center; font-size: 16px; font-weight: 700; color: #334155;">
        {{ reservation.cabane.nom }}
    </p>
    {% endif %}
    <div style="margin-top:30px;background:white;box-shadow:0 10px 20px #dddddd; border-radius:5px;padding:20px;max-width:480px;">
        <p style="margin: 0 0 20px; border-radius: 4px; background-color: #64748b; padding: 12px 16px; text-align: center; font-size: 20px; font-weight: 700; color: #fffffe; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05)">
            {{ title }}
        </p>
        <p class="text-center mb-0">{{ text }}</p>
        {% if reservation and reservation.cabane.fromEmail %}
        <p class="text-center mb-0" style="margin-top: 12px; font-size: 14px; color: #64748b;">
            Pour toute question : <a href="mailto:{{ reservation.cabane.fromEmail }}">{{ reservation.cabane.fromEmail }}</a>
        </p>
        {% endif %}
    </div>
</div>
{% endblock %}
